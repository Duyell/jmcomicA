<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose + edge-to-edge safe theme: NoActionBar, no translucent flags -->
    <style name="Theme.JMComicPDF" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <!-- 启动主题（Android 12+ 的 splash 属性在 values-v31 中定义，
         此为基础回退版本，供 API < 31 设备使用） -->
    <style name="Theme.JMComicPDF.Starting" parent="Theme.JMComicPDF" />
</resources>
